{
  "routes": [
    {
      "route": "/reservering",
      "redirect": "/reserveren",
      "statusCode": 301
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/css/*",
      "/js/*",
      "/images/*",
      "/videos/*",
      "/_framework/*",
      "/robots.txt",
      "/sitemap.xml"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".wasm": "application/wasm"
  }
}
