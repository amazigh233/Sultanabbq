@inject IJSRuntime JS

<nav class="nav @(scrolled ? "scrolled" : "")">
    <a class="nav-logo" href="/">Sultana BBQ</a>

    <div class="nav-links @(mobileOpen ? "open" : "")">
        <a href="/#home" @onclick="CloseMenu" @onclick:preventDefault="false">Home</a>
        <a href="/menu" @onclick="CloseMenu" @onclick:preventDefault="false">Menu</a>
        <a href="/afhalen-bezorgen" @onclick="CloseMenu" @onclick:preventDefault="false">Afhalen</a>
        <a href="/cocktail-builder" @onclick="CloseMenu" @onclick:preventDefault="false">Cocktails</a>
        <a href="/sauzenrad" @onclick="CloseMenu" @onclick:preventDefault="false">Sauzenrad</a>
        <a href="/halal-restaurant-utrecht" @onclick="CloseMenu" @onclick:preventDefault="false">Halal</a>
        <a href="/bbq-restaurant-overvecht" @onclick="CloseMenu" @onclick:preventDefault="false">BBQ</a>
        <a href="/contact" @onclick="CloseMenu" @onclick:preventDefault="false">Contact</a>
        <a href="/reserveren" @onclick="CloseMenu" @onclick:preventDefault="false">Reserveren</a>
        <a href="/personeel/tafels" @onclick="CloseMenu" @onclick:preventDefault="false">Personeel</a>
        <a class="nav-mobile-order-btn" href="/bestellen" @onclick="CloseMenu" @onclick:preventDefault="false">Bestellen</a>
    </div>

    <a class="nav-order-btn" href="/bestellen" @onclick="CloseMenu" @onclick:preventDefault="false">
        Bestellen
    </a>

    <button class="nav-hamburger @(mobileOpen ? "open" : "")" @onclick="ToggleMenu" aria-label="Menu openen">
        <span></span>
        <span></span>
        <span></span>
    </button>
</nav>

@code {
    private bool mobileOpen = false;
    private bool scrolled = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("SultanaInterop.initNavScroll", DotNetObjectReference.Create(this));
        }
    }

    private void ToggleMenu()
    {
        mobileOpen = !mobileOpen;
    }

    private void CloseMenu()
    {
        mobileOpen = false;
    }

    [JSInvokable]
    public void SetScrolled(bool value)
    {
        if (scrolled != value)
        {
            scrolled = value;
            StateHasChanged();
        }
    }
}
